#pragma fragment frag
#pragma target 4.0

#define CONCATENATE(a, b) a##b
#define TEX2D(name) Texture2D name; SamplerState CONCATENATE(sampler, name)
#define SAMPLE(tex, uv) tex.Sample(CONCATENATE(sampler, tex), uv)

// _MainTex : full resolution HDR scene
// _BloomTex : half resolution bloom, sampled with linear filtering
Texture2D _MainTex;
TEX2D(_BloomTex);

cbuffer HDRPostParams
{
	float4 hdr_PostParams;		// x - exposure, y - bloom intensity
	float4 hdr_TexelParams;	// xy - 1 / destination size
}

struct PS_INPUT
{
	float4 position : SV_POSITION;
	float2 uv : TEXCOORD0;
};

// Narkowicz ACES fit
float3 tonemapACES(float3 x)
{
	const float a = 2.51f;
	const float b = 0.03f;
	const float c = 2.43f;
	const float d = 0.59f;
	const float e = 0.14f;
	return saturate((x * (a * x + b)) / (x * (c * x + d) + e));
}

float4 frag(PS_INPUT input) : SV_Target
{
	float3 color = _MainTex.Load(int3(int2(input.position.xy), 0)).rgb;
	float3 bloom = SAMPLE(_BloomTex, input.position.xy * hdr_TexelParams.xy).rgb;
	color = (color + bloom * hdr_PostParams.y) * hdr_PostParams.x;
	return float4(tonemapACES(color), 1.0f);
}
