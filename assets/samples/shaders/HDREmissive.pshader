#pragma fragment frag
#pragma target 4.0

#define CONCATENATE(a, b) a##b
#define TEX2D(name) Texture2D name; SamplerState CONCATENATE(sampler, name)
#define SAMPLE(tex, uv) tex.Sample(CONCATENATE(sampler, tex), uv)

cbuffer HDREmissiveParams
{
	float4 hdr_EmissionColor;	// rgb - tint, a - intensity multiplier
}

// Float texture: values are already above 1 where the tube is brightest
TEX2D(_EmissionTex);

struct PS_INPUT
{
	float4 position : SV_POSITION;
	float2 uv : TEXCOORD0;
};

float4 frag(PS_INPUT input) : SV_Target
{
	float3 emission = SAMPLE(_EmissionTex, input.uv).rgb * hdr_EmissionColor.rgb * hdr_EmissionColor.a;
	return float4(emission, 1.0f);
}
