#pragma fragment frag
#pragma target 4.0

// 2x2 box downsample. Destination is floor(src / 2), so p + 1 never leaves the source.
Texture2D _MainTex;

struct PS_INPUT
{
	float4 position : SV_POSITION;
	float2 uv : TEXCOORD0;
};

float3 fetch(int2 p)
{
	return _MainTex.Load(int3(p, 0)).rgb;
}

float4 frag(PS_INPUT input) : SV_Target
{
	int2 p = int2(input.position.xy) * 2;
	float3 color = (fetch(p) + fetch(p + int2(1, 0)) + fetch(p + int2(0, 1)) + fetch(p + int2(1, 1))) * 0.25f;
	return float4(color, 1.0f);
}
