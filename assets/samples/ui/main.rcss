body
{
	font-family: "Noto Sans SC";
	font-size: 20dp;
	color: #f2f4f8;
	width: 100%;
	height: 100%;
}

#panel
{
	display: block;
	width: 420dp;
	margin: 24dp;
	padding: 16dp;
	background-color: #1d2433;
	border-width: 1dp;
	border-color: #3d4c66;
}

h1
{
	display: block;
	margin-bottom: 12dp;
	font-size: 28dp;
	color: #ffffff;
}

img.badge
{
	display: block;
	width: 96dp;
	height: 96dp;
	margin-bottom: 12dp;
}

#scroller
{
	display: block;
	width: 100%;
	height: 140dp;
	padding: 8dp;
	overflow: scroll;
	background-color: #121820;
	border-width: 1dp;
	border-color: #2c3848;
}

#scroller p
{
	display: block;
	margin-bottom: 8dp;
}

scrollbarvertical
{
	width: 10dp;
}

scrollbarhorizontal
{
	height: 10dp;
}

scrollbarvertical slidertrack,
scrollbarhorizontal slidertrack
{
	background-color: #121820;
}

scrollbarvertical sliderbar,
scrollbarhorizontal sliderbar
{
	background-color: #3d4c66;
}

#phase2
{
	display: block;
	position: absolute;
	top: 24dp;
	left: 480dp;
	width: 320dp;
	padding: 16dp;
	background-color: #1d2433;
	border-width: 1dp;
	border-color: #3d4c66;
}

#spin
{
	display: block;
	width: 180dp;
	height: 44dp;
	margin: 8dp 16dp 28dp;
	padding: 8dp;
	background-color: #c45c26;
	color: #ffffff;
	transform: rotate(30deg) scale(1.15);
}

#round
{
	display: block;
	width: 220dp;
	height: 64dp;
	margin: 12dp 16dp;
	padding: 8dp;
	border-radius: 32dp;
	overflow: hidden;
	background-color: #3d4c66;
}

#round p
{
	display: block;
	width: 280dp;
	margin: 8dp 0 0;
	padding: 6dp;
	background-color: #e8c07a;
	color: #1d2433;
}

#turned
{
	display: block;
	width: 170dp;
	height: 64dp;
	margin: 36dp 16dp 16dp;
	overflow: hidden;
	background-color: #2a6f6f;
	transform: rotate(-18deg);
}

#turned .spill
{
	display: block;
	width: 260dp;
	height: 36dp;
	margin-top: 14dp;
	padding: 6dp;
	background-color: #d2e6a0;
	color: #1d2433;
}
