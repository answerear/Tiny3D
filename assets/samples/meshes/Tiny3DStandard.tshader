ITION = stage_input.in_var_POSITION;\n    in_var_NORMAL = stage_input.in_var_NORMAL;\n    in_var_TEXCOORD0 = stage_input.in_var_TEXCOORD0;\n    vert_main();\n    SPIRV_Cross_Output stage_output;\n    stage_output.gl_Position = gl_Position;\n    stage_output.out_var_NORMAL = out_var_NORMAL;\n    stage_output.out_var_COLOR0 = out_var_COLOR0;\n    stage_output.out_var_COLOR1 = out_var_COLOR1;\n    stage_output.out_var_TEXCOORD0 = out_var_TEXCOORD0;\n    return stage_output;\n}\n"
