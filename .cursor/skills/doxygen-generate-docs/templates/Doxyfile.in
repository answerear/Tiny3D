# Tiny3D API docs — generated by doxygen-generate-docs skill.
# Do not edit by hand; regenerate via scripts/generate-docs.ps1.

PROJECT_NAME           = "Tiny3D"
PROJECT_BRIEF          = "Tiny3D API Reference"
PROJECT_NUMBER         =

OUTPUT_DIRECTORY       = @OUTPUT_DIRECTORY@
OUTPUT_LANGUAGE        = Chinese
CREATE_SUBDIRS         = NO

# --- Input: first-party Include/ trees (enumerated by generate-docs.ps1) ---
INPUT                  = @INPUT_DIR@
INPUT_ENCODING         = UTF-8
FILE_PATTERNS          = *.h \
                         *.hpp \
                         *.hxx \
                         *.hh
RECURSIVE              = YES
EXCLUDE_PATTERNS       = */External/* \
                         */dependencies/* \
                         */vs2019-x64/* \
                         */nmake/* \
                         */bin/* \
                         */lib/* \
                         */.cxx/* \
                         */CMakeFiles/* \
                         */Projects/* \
                         */Android/* \
                         */.git/* \
                         */.idea/* \
                         */node_modules/*
EXCLUDE_SYMBOLS        =

# Document all access levels (matches doxygen-core-api coverage).
# Protected members are included by default in Doxygen 1.10+ (no EXTRACT_PROTECTED tag).
EXTRACT_ALL            = NO
EXTRACT_PRIVATE        = YES
EXTRACT_STATIC         = YES
EXTRACT_LOCAL_CLASSES  = YES
HIDE_UNDOC_MEMBERS     = NO
HIDE_UNDOC_CLASSES     = NO
HIDE_FRIEND_COMPOUNDS  = YES
INTERNAL_DOCS          = NO

# Prefer \command style already used in headers.
JAVADOC_AUTOBRIEF      = NO
QT_AUTOBRIEF           = NO
MULTILINE_CPP_IS_BRIEF = NO

# --- Warnings ---
QUIET                  = NO
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = NO
WARN_IF_DOC_ERROR      = YES
WARN_NO_PARAMDOC       = NO
WARN_LOGFILE           = @WARN_LOGFILE@

# --- HTML ---
GENERATE_HTML          = YES
HTML_OUTPUT            = html
HTML_FILE_EXTENSION    = .html
GENERATE_TREEVIEW      = NO
DISABLE_INDEX          = NO
SEARCHENGINE           = NO
HTML_DYNAMIC_MENUS     = NO
HTML_CODE_FOLDING      = NO
HTML_COPY_CLIPBOARD    = NO
HTML_COLORSTYLE        = LIGHT
FULL_PATH_NAMES        = YES
STRIP_FROM_PATH        = @STRIP_FROM_PATH@
STRIP_FROM_INC_PATH    = @STRIP_FROM_PATH@
SOURCE_BROWSER         = YES
INLINE_SOURCES         = NO
REFERENCED_BY_RELATION = YES
REFERENCES_RELATION    = YES
VERBATIM_HEADERS       = YES

# --- CHM (HTML Help) ---
# hhc.exe 只认系统 ANSI（中文 Windows = GBK），不能用 UTF-8 写 .hhc/.hhk/.hhp，
# 否则左侧目录/索引中文乱码。HTML 正文仍为 UTF-8（charset=UTF-8）。
GENERATE_HTMLHELP      = @GENERATE_HTMLHELP@
CHM_FILE               = @CHM_FILE@
CHM_INDEX_ENCODING     = GBK
HHC_LOCATION           = @HHC_LOCATION@
GENERATE_CHI           = NO
BINARY_TOC             = YES
TOC_EXPAND             = NO

# --- Disable unused formats ---
GENERATE_LATEX         = NO
GENERATE_MAN           = NO
GENERATE_RTF           = NO
GENERATE_XML           = NO
GENERATE_DOCBOOK       = NO

# --- Diagrams (optional; no hard dependency on Graphviz) ---
HAVE_DOT               = NO

# --- Preprocessing ---
ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION        = YES
EXPAND_ONLY_PREDEF     = YES
SEARCH_INCLUDES        = YES
PREDEFINED             = "T3D_EXPORT_API=" \
                         "T3D_IMPORT_API=" \
                         "T3D_ENGINE_API=" \
                         "T3D_PLATFORM_API=" \
                         "T3D_MATH_API=" \
                         "T3D_UTILS_API=" \
                         "T3D_LOG_API=" \
                         "T3D_FRAMEWORK_API=" \
                         "T3D_SYSTEM_API=" \
                         "T3D_D3D11RENDERER_API=" \
                         "T3D_D3D9RENDERER_API=" \
                         "T3D_GL4RENDERER_API=" \
                         "T3D_GLES3RENDERER_API=" \
                         "T3D_VKRENDERER_API=" \
                         "T3D_NULLRENDERER_API=" \
                         "T3D_R3DRENDER_API=" \
                         "T3D_D3D11CONSOLE_API=" \
                         "T3D_GL4CONSOLE_API=" \
                         "T3D_VKCONSOLE_API=" \
                         "T3D_FSARCHIVE_API=" \
                         "T3D_BUNDLEFSARCHIVE_API=" \
                         "T3D_METAFSARCHIVE_API=" \
                         "T3D_ANDROIDASSET_API=" \
                         "T3D_ZIPARCHIVE_API=" \
                         "T3D_BUNDLEARCHIVE_API=" \
                         "T3D_FREEIMAGECODEC_API="

SORT_MEMBER_DOCS       = YES
SORT_BRIEF_DOCS        = NO
SHOW_INCLUDE_FILES     = YES
SHOW_FILES             = YES
SHOW_NAMESPACES        = YES
ALIASES                =
TAB_SIZE               = 4
